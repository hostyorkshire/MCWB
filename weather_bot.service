[Unit]
Description=MCWBv2 - MeshCore Weather Bot
# Wait for network to be fully online before starting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change 'pi' to your username if different
User=pi
# Change paths if you installed to a different location
WorkingDirectory=/home/pi/MCWB
ExecStart=/usr/bin/python3 /home/pi/MCWB/weather_bot.py --baud 115200 --announce
# Automatically restart if the bot crashes
Restart=on-failure
RestartSec=10
# Log to systemd journal (view with: sudo journalctl -u weather_bot -f)
StandardOutput=journal
StandardError=journal

# Note: Announcements are enabled by default (--announce flag above)
# To disable announcements, remove the --announce flag from ExecStart

# Optional: Uncomment to enable debug logging
# ExecStart=/usr/bin/python3 /home/pi/MCWB/weather_bot.py --baud 115200 --announce -d

# Optional: Uncomment to restrict to a specific channel index
# ExecStart=/usr/bin/python3 /home/pi/MCWB/weather_bot.py --baud 115200 --announce --channel-idx 1

# Optional: Uncomment to filter location searches to prefer UK cities (useful for UK deployments)
# ExecStart=/usr/bin/python3 /home/pi/MCWB/weather_bot.py --baud 115200 --announce --country GB

# Optional: For US deployments, use --country US
# ExecStart=/usr/bin/python3 /home/pi/MCWB/weather_bot.py --baud 115200 --announce --country US

[Install]
# Start automatically on boot
WantedBy=multi-user.target
