[Unit]
Description=MCWB - MeshCore Weather Bot
# Wait for network to be fully online before starting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change 'pi' to your username if different
User=pi
# Change paths if you installed to a different location
WorkingDirectory=/home/pi/MCWB
# Command to run the weather bot with announcements enabled
# --announce: Send announcements on every startup and periodically every 6 hours
# --reboot-notify: Send notification when bot restarts after reboot/crash
# Note: Bot defaults to UK locations (--country GB). For other countries, add: --country US
ExecStart=/usr/bin/python3 /home/pi/MCWB/weather_bot.py --baud 115200 --announce --reboot-notify

# Automatically restart if the bot crashes
Restart=on-failure
RestartSec=10
# Log to systemd journal (view with: sudo journalctl -u weather_bot -f)
StandardOutput=journal
StandardError=journal

[Install]
# Start automatically on boot
WantedBy=multi-user.target
