[flake8]
max-line-length = 120
extend-ignore = E501, W503, E203
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow imports not at top in __init__.py files
    __init__.py:F401,E402
    # Allow delayed imports in scripts (after sys.path modification)
    scripts/*.py:E402
    tests/*.py:E402,F401,F841
statistics = True
count = True

