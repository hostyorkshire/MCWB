[MASTER]
# Python code to execute, usually for sys.path manipulation
init-hook='import sys; sys.path.append(".")'

# Files or directories to be skipped
ignore=CVS,.git,__pycache__,.venv,venv,env,ENV,build,dist,logs

[MESSAGES CONTROL]
# Disable specific warnings that are common in this codebase
disable=
    C0111,  # missing-docstring
    C0103,  # invalid-name (for short variable names)
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    W0703,  # broad-except (we catch all exceptions in many places)
    R0912,  # too-many-branches
    R0915,  # too-many-statements

[FORMAT]
# Maximum number of characters on a single line
max-line-length=120

# String used as indentation unit
indent-string='    '

[BASIC]
# Good variable names which should always be accepted
good-names=i,j,k,ex,Run,_,e,f,fd,ip

[DESIGN]
# Maximum number of arguments for function / method
max-args=8

# Maximum number of locals for function / method body
max-locals=20

# Maximum number of return / yield for function / method body
max-returns=6

# Maximum number of branch for function / method body
max-branches=15

# Maximum number of statements in function / method body
max-statements=60
